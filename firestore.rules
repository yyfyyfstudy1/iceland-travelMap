rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The admin is identified by the signed-in email. Change ADMIN_EMAIL to your
    // Firebase Auth account, then only that account can edit tours / rates.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'yyfnhk@gmail.com';
    }
    match /tours/{doc} {
      allow read: if true;          // public map
      allow write: if isAdmin();    // admin dashboard only
    }
    match /config/{doc} {
      allow read: if true;          // rates read by the public map
      allow write: if isAdmin();    // rate updates from the admin dashboard
    }
  }
}
